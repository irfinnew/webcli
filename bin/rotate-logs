#! /bin/zsh

set -e

cd "$HOME/logs"

# Move log files
for FILE in *.log(N)
do
	if [ -s "$FILE" ]
	then
		mv "$FILE" "${FILE:r}-$(date -d '12 hours ago' "+%Y-%m-%d").log"
	fi
done

# Wait a bit to ensure all writes to file are finished
sleep 300

# Compress archived logs
for FILE in *-????-??-??.log(N)
do
	nice nice gzip "${FILE}"
done

find -type f -mtime +35 -delete
